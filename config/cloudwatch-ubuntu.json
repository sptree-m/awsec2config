{
  "agent": { "run_as_user": "root" },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": { "files": { "collect_list": [
      { "file_path": "/var/log/awsec2config-auth.log", "log_group_name": "/ec2/security/ubuntu/auth", "log_stream_name": "{instance_id}" },
      { "file_path": "/var/log/audit/audit.log", "log_group_name": "/ec2/security/ubuntu/audit", "log_stream_name": "{instance_id}" }
    ] } }
  }
}
